# ==============================================================================
# CareerPilot AI — Root .gitignore
# Comprehensive security, environment, cache, and artifact exclusions
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Configuration Files
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
*.env.local
*.env.*.local
*.local
backend/.env
frontend/.env

# Safe template preservation: Explicitly allow .env.example files
!.env.example
!**/.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 2. Database & Data Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
careerpilot.db
backend/careerpilot.db

# SQLite journal, WAL, and shared memory lock files
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite3-journal

# Database dumps and backup files
*.bak
*.backup
*.dump
*.sql.bak

# ------------------------------------------------------------------------------
# 3. Python Virtual Environments & Packages
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
backend/.venv/
backend/venv/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 4. Python Caches & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ------------------------------------------------------------------------------
# 5. Testing, Linting & Coverage Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.ruff_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# 6. Node.js & Frontend Artifacts
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.next/
frontend/out/
*.tsbuildinfo
.npm/
.eslintcache

# ------------------------------------------------------------------------------
# 7. Uploaded Documents & Private User Resumes
# ------------------------------------------------------------------------------
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
*.pdf
*.docx
*.doc
!docs/**/*.pdf
!docs/**/*.docx

# ------------------------------------------------------------------------------
# 8. Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.temp
.temp/
.tmp/

# ------------------------------------------------------------------------------
# 9. IDE, Editor & OS Metadata
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
